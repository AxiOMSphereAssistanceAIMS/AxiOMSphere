+            "training_tracks": {"slot14": 1, "slot32": 2, "slot120": 0},
+        },
+    )
+
+    outputs = create_self_improvement_handoff(
+        run_dir=run_dir,
+        document_type="policy_framework",
+    )
+
+    manifest = json.loads(outputs["training_queue_manifest"].read_text())
+    agent_queue = json.loads(outputs["agent_training_queue"].read_text())
+    model_queue = json.loads(outputs["model_training_queue"].read_text())
+    stability_queue = json.loads(outputs["stability_queue"].read_text())
+    skill_validation_queue = json.loads(outputs["skill_validation_queue"].read_text())
+    scope_payload = json.loads(outputs["skill_scope_decisions"].read_text())
+
+    assert manifest["queue_counts"]["agent_training_queue"] >= 2
+    assert manifest["queue_counts"]["model_training_queue"] == 3
+    assert manifest["queue_counts"]["stability_queue"] == 1
+    assert manifest["queue_counts"]["skill_validation_queue"] == 15
+    assert any(item["track"] == "slot14" for item in agent_queue)
+    assert any(item["track"] == "slot32" for item in agent_queue)
+    assert len(model_queue) == 3
+    assert len(skill_validation_queue) == 15
+    assert skill_validation_queue[0]["requires_approval"] is False
+    assert stability_queue[0]["queue_type"] == "stability_queue"
+    assert manifest["training_tracks"]["slot32"] == 2
+    assert scope_payload["summary"]["shared_candidates"] >= 1
+
+
+def test_handoff_disabled_preserves_failure_evidence_without_training(tmp_path):
+    run_dir = tmp_path / "run"
+    cycle = run_dir / "cycle_01"
+    cycle.mkdir(parents=True)
+    (cycle / "draft.md").write_text("# Policy Framework", encoding="utf-8")
+    _write(cycle / "metrics.json", {"overall_score": 0.91, "changes_applied": []})
+    _write(cycle / "document_profile_conformance.json", {"status": "REVIEW"})
+    _write(cycle / "skills_report.json", {"hard_gate_allowed": False})
+    _write(cycle / "training_quarantine.json", {"hard_gate_failures": ["gap"]})
+    _write(cycle / "repair_plan.json", {"selected_count": 2})
+    _write(cycle / "section_failure_diagnostics.json", {"failures": []})
+
+    outputs = create_self_improvement_handoff(
+        run_dir=run_dir,
+        document_type="policy_framework",
+        export_training_intake=True,
+        self_improvement_enabled=False,
+    )
+
+    readiness = json.loads(outputs["self_improvement_readiness"].read_text())
+    manifest = json.loads(outputs["training_queue_manifest"].read_text())
+    ledger = json.loads(outputs["problem_ledger"].read_text())
+    skills = json.loads(outputs["skill_candidate_requests"].read_text())
+
+    assert readiness["decision"] == "GENERATION_ONLY"
+    assert readiness["autonomous_self_improvement_ready"] is False
+    assert readiness["governance"]["self_improvement_enabled"] is False
+    assert manifest["status"] == "SELF_IMPROVEMENT_DISABLED"
+    assert manifest["queue_counts"]["skill_validation_queue"] == 0
+    assert ledger["problem_count"] >= 1
+    assert skills["request_count"] >= 0
