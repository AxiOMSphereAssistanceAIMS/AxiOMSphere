+    async def _exec_schedule_task(self, params: dict) -> tuple[bool, str]:
+        """Enqueue a task into the Redis scheduler.
+
+        Argus enqueues only — does NOT execute commands directly.
+        Flow: validate params → build TaskMetadata → persist hash → enqueue.
+        RedisQueueManager.schedule_task() publishes TASK_SCHEDULED internally;
+        Argus must NOT publish it again.
+        """
+        if not _SCHEDULER_AVAILABLE:
+            return False, "schedule_task: scheduler not available (import failed)"
+
+        # ── 1. Required params ─────────────────────────────────────────────
+        task_type = params.get("task_type", "")
+        command = params.get("command", [])
+        scheduled_for = params.get("scheduled_for", "")
+
+        if not task_type:
+            return False, "schedule_task: missing required param 'task_type'"
+        if not command:
+            return False, "schedule_task: missing required param 'command'"
+        if not scheduled_for:
+            return False, "schedule_task: missing required param 'scheduled_for'"
+        if not isinstance(command, list):
+            return False, f"schedule_task: 'command' must be a list, got {type(command).__name__}"
+
+        # ── 2. Task-type allowlist ─────────────────────────────────────────
+        if task_type not in _ALLOWED_TASK_TYPES and task_type not in _GATED_TASK_TYPES:
+            return False, f"schedule_task: task_type '{task_type}' not in allowlist"
+
+        # ── 3. Gated training policy ───────────────────────────────────────
+        if task_type in _GATED_TASK_TYPES and not params.get("gated_training_approved"):
+            return False, (
+                f"schedule_task: task_type '{task_type}' requires "
+                "'gated_training_approved: true' in params"
+            )
+
+        # ── 4. Command validation ──────────────────────────────────────────
+        cmd_str = " ".join(str(c) for c in command)
+        if not any(cmd_str.startswith(p) for p in _CMD_ALLOWED_PREFIXES):
+            return False, (
+                f"schedule_task: command must start with one of "
+                f"{_CMD_ALLOWED_PREFIXES}, got: {cmd_str[:80]}"
+            )
+        for forbidden in _CMD_FORBIDDEN_PATTERNS:
+            if forbidden in cmd_str:
+                return False, f"schedule_task: forbidden pattern '{forbidden}' in command"
+
+        # ── 5. Timestamp validation ────────────────────────────────────────
+        try:
+            ts_norm = scheduled_for.replace("Z", "+00:00")
+            scheduled_dt = datetime.fromisoformat(ts_norm)
+            now_ref = (
+                datetime.now(tz=timezone.utc)
+                if scheduled_dt.tzinfo is not None
+                else datetime.utcnow()
+            )
+            if (now_ref - scheduled_dt).total_seconds() > 300:
+                return False, (
+                    f"schedule_task: 'scheduled_for' is >5 min in the past: {scheduled_for}"
+                )
+        except ValueError as exc:
+            return False, f"schedule_task: invalid 'scheduled_for' timestamp: {exc}"
+
+        # ── 6. Build TaskMetadata ──────────────────────────────────────────
+        task_id = params.get("task_id") or f"argus-{task_type}-{uuid.uuid4().hex[:8]}"
+        metadata = TaskMetadata(
+            task_id=task_id,
+            task_type=task_type,
+            command=command,
+            scheduled_for=scheduled_for,
+            created_at=datetime.utcnow().isoformat(),
+            created_by="argus",
+            status=TaskStatus.PENDING.value,
+            retry_count=0,
+            max_retries=int(params.get("max_retries", 3)),
+            priority=int(params.get("priority", 50)),
