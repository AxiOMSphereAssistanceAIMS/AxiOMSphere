+# ── Scheduler health query (used by argus_bot /scheduler command) ────────────
+
+async def get_scheduler_status() -> dict:
+    """Query Redis for scheduler daemon health and queue counts.
+
+    Returns a dict with keys:
+        available       — scheduler imports succeeded
+        daemon_alive    — heartbeat key present and fresh
+        heartbeat_age_s — seconds since last heartbeat write, or None
+        stale           — heartbeat older than 150s threshold
+        pending         — tasks waiting to run
+        running         — tasks currently executing
+        retrying        — tasks in retry backoff
+        failed          — tasks that exhausted retries
+        held_for_review — tasks held after missed-start scan
+        error           — str, only present on Redis connection failure
+    """
+    if not _SCHEDULER_AVAILABLE:
+        return {
+            "available": False,
+            "daemon_alive": False,
+            "heartbeat_age_s": None,
+            "stale": False,
+            "pending": 0,
+            "running": 0,
+            "retrying": 0,
+            "failed": 0,
+            "held_for_review": 0,
+        }
+
+    redis_url = (
+        os.getenv("AIMS_REDIS_URL")
+        or os.getenv("TASK_SCHEDULER_REDIS_URL")
+        or "redis://localhost:6379"
+    )
+    _HEARTBEAT_STALE_THRESHOLD = 150  # 2.5× the 60s write interval
+
+    try:
+        client = await _aioredis.from_url(redis_url, decode_responses=True)
+        try:
+            raw_hb = await client.get("scheduler:daemon:heartbeat")
+            pending = await client.zcard("scheduler:tasks:pending")
+            running = await client.zcard("scheduler:tasks:running")
+            retrying = await client.zcard("scheduler:tasks:retrying")
+            failed = await client.zcard("scheduler:tasks:failed")
+            held = await client.zcard("scheduler:tasks:missed_startup_review")
+        finally:
+            await client.aclose()
+    except Exception as exc:
+        log.warning("get_scheduler_status: Redis error — %s", exc)
+        return {
+            "available": True,
+            "daemon_alive": False,
+            "heartbeat_age_s": None,
+            "stale": True,
+            "pending": 0,
+            "running": 0,
+            "retrying": 0,
+            "failed": 0,
+            "held_for_review": 0,
+            "error": str(exc),
+        }
+
+    if raw_hb is None:
+        return {
+            "available": True,
+            "daemon_alive": False,
+            "heartbeat_age_s": None,
+            "stale": True,
+            "pending": pending,
+            "running": running,
+            "retrying": retrying,
+            "failed": failed,
+            "held_for_review": held,
+        }
+
+    try:
+        age = int(time.time()) - int(raw_hb)
+        stale = age > _HEARTBEAT_STALE_THRESHOLD
+    except ValueError:
+        age = None
+        stale = True
+
+    return {
+        "available": True,
+        "daemon_alive": age is not None and not stale,
+        "heartbeat_age_s": age,
+        "stale": stale,
+        "pending": pending,
+        "running": running,
+        "retrying": retrying,
+        "failed": failed,
+        "held_for_review": held,
+    }
+
+
+async def get_scheduler_detail() -> dict:
+    """Extended scheduler status: base health + last completed/failed tasks + totals.
+
+    Calls get_scheduler_status() (stable contract, 51 tests) then opens a second
+    Redis connection to fetch completed-queue stats and last-task metadata.
+
+    Additional keys beyond get_scheduler_status():
+        completed_total — int, count of tasks ever completed (zcard)
+        last_completed  — dict with task_id/task_type/created_at/display_name, or None
+        last_failed     — dict with task_id/task_type/error/created_at, or None
+    """
+    base = await get_scheduler_status()
+
+    # Seed defaults so callers always get the keys regardless of path
+    base.setdefault("completed_total", 0)
+    base.setdefault("last_completed", None)
+    base.setdefault("last_failed", None)
+
+    if not base.get("available") or "error" in base:
+        return base
+
+    redis_url = (
+        os.getenv("AIMS_REDIS_URL")
+        or os.getenv("TASK_SCHEDULER_REDIS_URL")
+        or "redis://localhost:6379"
+    )
+    try:
+        client = await _aioredis.from_url(redis_url, decode_responses=True)
+        try:
+            completed_total = await client.zcard("scheduler:tasks:completed")
+            last_cmp_ids = await client.zrange("scheduler:tasks:completed", -1, -1)
+            last_fail_ids = await client.zrange("scheduler:tasks:failed", -1, -1)
+
+            last_completed = None
+            if last_cmp_ids:
+                raw = await client.hgetall(f"scheduler:task:{last_cmp_ids[0]}")
+                if raw:
+                    last_completed = {
+                        "task_id": raw.get("task_id", last_cmp_ids[0]),
+                        "task_type": raw.get("task_type", "unknown"),
+                        "display_name": raw.get("display_name") or raw.get("task_type", ""),
+                        "created_at": raw.get("created_at", ""),
+                    }
+
+            last_failed = None
+            if last_fail_ids:
+                raw = await client.hgetall(f"scheduler:task:{last_fail_ids[0]}")
+                if raw:
+                    last_failed = {
+                        "task_id": raw.get("task_id", last_fail_ids[0]),
+                        "task_type": raw.get("task_type", "unknown"),
+                        "error": raw.get("error", "")[:120],
+                        "created_at": raw.get("created_at", ""),
+                    }
+        finally:
+            await client.aclose()
+    except Exception as exc:
+        log.warning("get_scheduler_detail: Redis error during detail query — %s", exc)
+        # Return base status intact; detail fields remain at defaults
+        return base
+
+    base["completed_total"] = completed_total
+    base["last_completed"] = last_completed
+    base["last_failed"] = last_failed
+    return base
+
+
+async def get_scheduler_backpressure_detail() -> dict:
+    """Extends get_scheduler_detail() with real-time backpressure and slot occupancy.
+
+    Calls get_scheduler_detail() (which calls get_scheduler_status()) then opens
+    a third Redis connection to read running task metadata and derive slot states,
+    mutex lock state, active resource key locks, and queue pressure level.
+
+    Additional keys beyond get_scheduler_detail():
+        slot_states          — {slot14, slot32, slot120} → "free" | "busy"
+        mutex_locked         — bool; True if slot32 or slot120 is running (mutex active)
+        running_slots        — list[{task_id, task_type, model_slot}] for slotted tasks
+        active_resource_keys — list[str] of resource_key values currently held
+        global_limit         — int; ResourcePolicyConfig default (3)
+        queue_pressure       — "OK" | "WARN" | "CRITICAL"
+    """
+    from ops.scheduler.resource_policy import ResourcePolicyConfig
+
+    base = await get_scheduler_detail()
+
+    # Seed backpressure defaults so callers always get all keys
+    base.setdefault("slot_states", {"slot14": "free", "slot32": "free", "slot120": "free"})
+    base.setdefault("mutex_locked", False)
+    base.setdefault("running_slots", [])
+    base.setdefault("active_resource_keys", [])
+    base.setdefault("global_limit", ResourcePolicyConfig().global_max_concurrent)
+    base.setdefault("queue_pressure", "OK")
+
+    if not base.get("available") or "error" in base:
+        return base
+
+    redis_url = (
+        os.getenv("AIMS_REDIS_URL")
+        or os.getenv("TASK_SCHEDULER_REDIS_URL")
+        or "redis://localhost:6379"
+    )
+    try:
+        client = await _aioredis.from_url(redis_url, decode_responses=True)
+        try:
+            running_ids = await client.zrange("scheduler:tasks:running", 0, -1)
+            running_slots: list[dict] = []
+            active_resource_keys: list[str] = []
+            for task_id in running_ids:
+                raw = await client.hgetall(f"scheduler:task:{task_id}")
+                if not raw:
+                    continue
+                slot = raw.get("model_slot") or None
+                rkey = raw.get("resource_key") or None
+                if slot:
+                    running_slots.append({
+                        "task_id": task_id,
+                        "task_type": raw.get("task_type", "unknown"),
+                        "model_slot": slot,
+                    })
+                if rkey:
+                    active_resource_keys.append(rkey)
+        finally:
+            await client.aclose()
+    except Exception as exc:
+        log.warning("get_scheduler_backpressure_detail: Redis error — %s", exc)
+        return base
+
+    occupied_slots = {r["model_slot"] for r in running_slots}
+    slot_states = {
+        "slot14":  "busy" if "slot14"  in occupied_slots else "free",
+        "slot32":  "busy" if "slot32"  in occupied_slots else "free",
+        "slot120": "busy" if "slot120" in occupied_slots else "free",
+    }
+    mutex_locked = slot_states["slot32"] == "busy" or slot_states["slot120"] == "busy"
+
+    global_limit = ResourcePolicyConfig().global_max_concurrent
+    running_count = base.get("running", 0)
+    pending_count = base.get("pending", 0)
+    if running_count >= global_limit:
+        queue_pressure = "CRITICAL"
+    elif running_count >= global_limit - 1 or pending_count > 5:
+        queue_pressure = "WARN"
+    else:
+        queue_pressure = "OK"
+
+    base["slot_states"] = slot_states
+    base["mutex_locked"] = mutex_locked
+    base["running_slots"] = running_slots
+    base["active_resource_keys"] = active_resource_keys
+    base["global_limit"] = global_limit
+    base["queue_pressure"] = queue_pressure
+    return base
+
+
 def _argus_problem_name(self, step_id: str, description: str) -> str:
     return normalize_problem_name(step_id, description)
 
