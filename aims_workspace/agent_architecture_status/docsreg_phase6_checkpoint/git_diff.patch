+            return False, f"schedule_task: Redis error: {exc}"
+
+        log.info(
+            "schedule_task: enqueued task_id=%s type=%s scheduled_for=%s",
+            task_id, task_type, scheduled_for,
+        )
+        return True, f"task_id={task_id}"
