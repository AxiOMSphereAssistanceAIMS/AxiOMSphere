{
  "name": "axiomsphere-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "rm -f dist/200.html && react-snap",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:public-deploy": "node scripts/validate-public-deploy.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "inlineCss": false,
    "crawl": false,
    "include": ["/"],
    "puppeteerExecutablePath": "/snap/bin/chromium",
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "viewport": { "width": 1440, "height": 8000 },
    "timeout": 3000
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.28",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.9.1",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
