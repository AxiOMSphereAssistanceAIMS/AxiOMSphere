# Night Traini tuning registration — cron only enqueues; Redis Scheduler owns execution.
10 1  *  *  *    cd /home/axi_omi_sphere/aims-workspace && TASK_SCHEDULER_REDIS_URL=${TASK_SCHEDULER_REDIS_URL:-${AIMS_REDIS_URL:-redis://localhost:6379}} PYTHONPATH=/home/axi_omi_sphere/aims-workspace python3 ops/scripts/enqueue_traini_night_tuning.py --slot 14 >> /var/log/scheduler.log 2>&1
20 1  *  *  *    cd /home/axi_omi_sphere/aims-workspace && TASK_SCHEDULER_REDIS_URL=${TASK_SCHEDULER_REDIS_URL:-${AIMS_REDIS_URL:-redis://localhost:6379}} PYTHONPATH=/home/axi_omi_sphere/aims-workspace python3 ops/scripts/enqueue_traini_night_tuning.py --slot 32 >> /var/log/scheduler.log 2>&1
30 1  *  *  *    cd /home/axi_omi_sphere/aims-workspace && TASK_SCHEDULER_REDIS_URL=${TASK_SCHEDULER_REDIS_URL:-${AIMS_REDIS_URL:-redis://localhost:6379}} PYTHONPATH=/home/axi_omi_sphere/aims-workspace python3 ops/scripts/enqueue_traini_night_tuning.py --slot 120 >> /var/log/scheduler.log 2>&1

# One-shot launch request: 2026-05-14 08:39 Dubai (UTC+4)
39 8 14 5 *    /scripts/night_qwen32_ft.sh >> /var/log/scheduler.log 2>&1

# Slot14 primary: ПК Андрея. Регулярно продлеваем remote keep_alive=24h.
# DGX не прогревается: он остаётся холодным fallback после 60-секундного recovery grace.
*/15 * * * *    /scripts/qwen_pc_warm.sh >> /var/log/scheduler.log 2>&1

# Job Filter full scan — 05:00 Dubai.
# Cron only enqueues; Redis Scheduler owns execution, heartbeat, status, and retry/audit metadata.
0  5  *  *  *    cd /home/axi_omi_sphere/aims-workspace && TASK_SCHEDULER_REDIS_URL=${TASK_SCHEDULER_REDIS_URL:-${AIMS_REDIS_URL:-redis://aims-redis:6379}} PYTHONPATH=/home/axi_omi_sphere/aims-workspace:/home/axi_omi_sphere/aims-workspace/ops python3 ops/scripts/enqueue_job_filter_morning.py >> /var/log/scheduler.log 2>&1

# День 08:00 — боты и интерактив
0  8  *  *  *    /scripts/day_work.sh     >> /var/log/scheduler.log 2>&1


# PlannedActionExecutionDaemon supervisor — cron only starts; daemon manages all scheduling internally
# Runs at @reboot and every 5 min as watchdog (daemon exits when done / on SIGTERM)
@reboot  /scripts/planned_action_daemon_entrypoint.sh >> /var/log/pa-daemon.log 2>&1
*/5 *  *  *  *  pgrep -f planned_action_execution_daemon.py || /scripts/planned_action_daemon_entrypoint.sh >> /var/log/pa-daemon.log 2>&1

