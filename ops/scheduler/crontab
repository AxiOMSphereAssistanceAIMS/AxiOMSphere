# Вечер 23:55 — остановить интерактивный стек (боты/LLM до day_work)
55 23  *  *  *    /scripts/evening_stop.sh   >> /var/log/scheduler.log 2>&1

# Ночь 01:00 — один job, ветвление Пн–Пт vs Сб–Вс: cron_night.sh (прогрев ПК, ночные тесты)
